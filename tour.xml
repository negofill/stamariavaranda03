				<!-- ==================== PLAYER DE VÍDEO ==================== -->
				<plugin name="player_video"
						url.html5="%VIEWER%/plugins/videoplayer.js"
						url.flash="%VIEWER%/plugins/videoplayer.swf"
						visible="false"
						keep="true"
						align="center"
						width="70%"
						height="prop"
						zorder="100"
						bgcapture="true"
						autoplay="true"
						muted="true"
						onvideocomplete="ocultar_video();"
						onclick="ocultar_video();"
				/>

				<!-- ==================== OVERLAY DE FUNDO ==================== -->
				<layer name="overlay_video"
					type="container"
					bgcolor="0x000000"
					bgalpha="0.0"
					width="100%"
					height="100%"
					align="center"
					keep="true"
					visible="false"
					zorder="15"
					bgcapture="true"
					onclick="ocultar_video();"
				/>

				<action name="abrir_video">
							set(layer[overlay_video].visible, true);
					tween(layer[overlay_video].bgalpha, 0.7, 0.3);

							set(plugin[player_video].visible, true);
					plugin[player_video].playvideo('%1');
				</action>

					<action name="ocultar_video">
							plugin[player_video].stop(); 
					set(plugin[player_video].visible, false);

					tween(layer[overlay_video].bgalpha, 0.0, 0.3, default, set(layer[overlay_video].visible, false));
				</action>






