<krpano>


    <style name="card_vidro"
           type="container"
           keep="true"
           bgcolor="0xffffff"   
           bgalpha="0.15"
           bgborder="2 0xffffff 1.0"
           bgroundedge="25"
           bgblur="3.0"
           bgshadow="-7 7 5 0x000000 0.5"
           bgcapture="true"
    />
    
    <style name="card_vidro_02"
           type="container"
           keep="true"
           bgcolor="0xffffff"   
           bgalpha="0.40"
           bgborder="0 0xffffff 1.0"
           bgroundedge="20"
           bgblur="1.0"
           bgcapture="true"
    />

    <style name="logo_container_style"
           type="container"
           align="top"
           width="90%"
           height="150"
           y="25"
           bgcolor="0x015865"
           bgalpha="0.9"
           bgroundedge="20"
    />
    
    <style name="btn_apartamento" 
           type="text" 
           keep="true"
           align="top" 
           width="70"           
           css="color:#0a5a60; font-family:Arial; font-size:18px; font-weight:bold; text-align:center; line-height:45px;"
           bgcolor="0xffffff" 
           bgalpha="0.9" 
           bgroundedge="12"
           bgshadow="0 2 5 0x000000 0.1"
           cursor="pointer"
           onover="set(bgalpha, 1.0); set(css, 'color:#000000; font-family:Arial; font-size:18px; font-weight:bold; text-align:center; line-height:45px;');"
           onout="set(bgalpha, 0.9); set(css, 'color:#0a5a60; font-family:Arial; font-size:18px; font-weight:bold; text-align:center; line-height:45px;');"
    />

    <style name="txt_coluna" 
           type="text" 
           keep="true"
           align="top" 
           edge="top"
           width="75"           
           css="color:#ffffff; font-family:Arial; font-size:12px; font-weight:bold; text-align:center; line-height:25px;"
           bgcolor="0x006666" 
           bgalpha="1.0" 
           bgroundedge="8"
    />


    

    <layer name="menu_principal" style="card_vidro" width="440" height="560" align="center" x="-20%" y="0" zorder="10">
        
        <layer name="logo_container" style="logo_container_style">
            <layer name="logo_img" url="lg_aquln.png" align="center" keep="true" scale="0.6" />
        </layer>
        
        <layer name="container_colunas" style="card_vidro_02" align="center" y="15%" height="60%" width="90%" zorder="12" >
            
