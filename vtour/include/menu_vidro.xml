                <layer name="apt_1201" style="btn_apartamento" html="1201" y="60"  onover="set(hotspot[hsapto1201].visible,true);"  onout="set(hotspot[hsapto1201].visible,false);" onclick="abrir_video('%VIEWER%/videos/c01/apto_1201.mp4');"/>
